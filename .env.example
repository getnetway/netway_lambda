# ── Netway API connection ─────────────────────────────────────────────────────
# URL of the Netway API server the Lambda ships flows to.
NETWAY_API_URL=https://netway.basavytix.com
# API key issued on registration at https://netway.basavytix.com
NETWAY_API_KEY=nw_live_your_key_here

# ── Flow log source ───────────────────────────────────────────────────────────
CLOUD_PROVIDER=aws
FLOW_LOG_SOURCE=s3_athena
# S3 bucket receiving VPC flow logs (format: netway-<account_id>-<region>)
FLOW_LOGS_S3_BUCKET=
ATHENA_RESULTS_BUCKET=
ATHENA_WORKGROUP=netway-analyzer
ATHENA_DATABASE=netway

# ── Scan settings ─────────────────────────────────────────────────────────────
# Number of days of flow logs to analyse per scan
ANALYSIS_DAYS=30
# Minimum bytes per flow to include (0 = no filter; set to 1 for testing)
MIN_BYTES_PER_FLOW=0

# ── AWS Marketplace (optional) ────────────────────────────────────────────────
MARKETPLACE_ENABLED=false
MARKETPLACE_PRODUCT_CODE=
